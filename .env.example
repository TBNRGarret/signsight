# Reference only: neither backend.manage nor the app automatically loads .env.
# Set process environment variables before running migrations and Uvicorn.
# Relative paths below are resolved from the project root.
DATABASE_URL=sqlite:///backend/signsight.db
SIGNSIGHT_STORAGE_ROOT=backend/uploads/images
SIGNSIGHT_YOLO_WEIGHTS=ai_engine/checkpoints/detection/best.pt
SIGNSIGHT_YOLO_DEVICE=cpu
SIGNSIGHT_YOLO_CONFIDENCE=0.65
SIGNSIGHT_SESSION_MINUTES=480
SIGNSIGHT_REMEMBER_DAYS=30
SIGNSIGHT_CONFIRMATION_DAYS=30
SIGNSIGHT_AUTO_MIGRATE=true
SIGNSIGHT_MAX_UPLOAD_BYTES=10485760
SIGNSIGHT_MAX_IMAGE_PIXELS=16000000
SIGNSIGHT_LIFECYCLE_INTERVAL_SECONDS=60
SIGNSIGHT_PLACES_PROVIDER=photon
SIGNSIGHT_ROUTING_BASE_URL=https://router.project-osrm.org
# No credentials belong in this example. Bootstrap the first admin interactively.

# Optional cropped-image classifier checkpoint (not shown in the user capture flow).
SIGNSIGHT_CNN_WEIGHTS=ai_engine/checkpoints/best_model.pth
